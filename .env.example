# Demo mode works without credentials. Keep this setting for product demos.
AI_PROVIDER=demo

# Keep the local app private to this computer by default. For a hosted preview,
# set PRIVATE_DEMO=true and provide a strong DEMO_PASSWORD in the host dashboard.
PRIVATE_DEMO=false
DEMO_PASSWORD=
HOST=127.0.0.1

# For real AI image generation, use one provider and add its key.
# Gemini Nano Banana 2 (paid image generation):
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Or use OpenAI:
# AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional model overrides; defaults are already set in server.js.
# OPENAI_TEXT_MODEL=gpt-6.2-astra
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# PORT=4173
